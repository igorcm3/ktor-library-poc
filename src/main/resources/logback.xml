<configuration>
    <!-- Silenciar logs de status do Logback -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan([%logger{0}]) %msg%n</pattern>
        </encoder>
    </appender>
    
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
    
    <!-- Silenciar completamente bibliotecas verbosas -->
    <logger name="org.eclipse.jetty" level="OFF"/>
    <logger name="io.netty" level="OFF"/>
    <logger name="io.ktor" level="WARN"/>
    <logger name="Exposed" level="WARN"/>
    <logger name="org.koin" level="OFF"/>
    <logger name="Koin" level="OFF"/>
    
    <!-- Silenciar completamente o Swagger Codegen -->
    <logger name="io.swagger" level="OFF"/>
    <logger name="io.swagger.codegen" level="OFF"/>
    <logger name="io.swagger.codegen.v3" level="OFF"/>
    <logger name="io.swagger.v3" level="OFF"/>
    
    <!-- Apenas logs essenciais da aplicação -->
    <logger name="Application" level="INFO"/>
    <logger name="com.library" level="INFO"/>
</configuration>